    {
      "file": "Application_for_name_change_next_steps.docx",
      "variables": [
        "court_administrator_address",
        "court_administrator_city_state_zip",
        "has_felony",
        "hennepin_packet",
        "included_children",
        "parent_address_known",
        "parental_notice_needed",
        "parents_nonapplicant_unknown",
        "release_people",
        "request_fee_waiver",
        "users",
        "users1_divorced_seeking_change_to_legal_name_on_birth_certificate",
        "users1_inmate_in_correctional_facility_and_submitting_inmate_aff"
      ],
      "jinja_labels": [
        "users[0].name.full()",
        "release_people | length",
        "court_administrator_address",
        "court_administrator_city_state_zip"
      ],
      "conditional_and_loop_tags": [
        "p if hennepin_packet",
        "p endif",
        "p if users1_divorced_seeking_change_to_legal_name_on_birth_certificate",
        "p endif",
        "p if has_felony",
        "p endif",
        "p if users1_inmate_in_correctional_facility_and_submitting_inmate_aff",
        "p endif",
        "p if parental_notice_needed",
        "p if not parent_address_known",
        "p endif",
        "p endif",
        "p if included_children and parents_nonapplicant_unknown",
        "p endif",
        "p if request_fee_waiver",
        "p if users1_inmate_in_correctional_facility_and_submitting_inmate_aff",
        "p else",
        "p endif",
        "p endif"
      ],
      "manual_execution_fields": "Signatures, initials, signing dates and notarial/witness attestations remain blank where applicable."
    },
    {
      "file": "criminal_history_releases.docx",
      "variables": [
        "release_people"
      ],
      "jinja_labels": [
        "person.name.full()",
        "person.release_other_names",
        "person.birthdate.format()",
        "\"\u2612\" if person.release_sex == \"Female\" else \"\u2610\"",
        "\"\u2612\" if person.release_sex == \"Male\" else \"\u2610\"",
        "person.release_race"
      ],
      "conditional_and_loop_tags": [
        "p for person in release_people",
        "p if not loop.last",
        "p endif",
